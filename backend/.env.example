# ============================================================
# Yashil Art - Backend Environment Variables
# ============================================================

# ------------------------------------------------------------
# Environment
# development / production
# ------------------------------------------------------------
DJANGO_ENV=development

# 1 = development
# 0 = production
DJANGO_DEBUG=1

# ------------------------------------------------------------
# Django Security
# ------------------------------------------------------------
DJANGO_SECRET_KEY=change-this-development-secret-key

# Comma-separated hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Development:
# Leave empty -> SQLite will be used.
#
# Production:
# Must be set to the MariaDB connection URL.
#
# Example:
# mysql://username:password@localhost:3306/database_name
#
DATABASE_URL=

# 1 only if database server requires SSL
DATABASE_SSL_REQUIRE=0

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:8080

FRONTEND_RESET_PASSWORD_URL=http://localhost:8080/reset-password

FRONTEND_PAYMENT_RESULT_URL=http://localhost:8080/payment-result

# ------------------------------------------------------------
# Email
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1

# ------------------------------------------------------------
# Production security
# ------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=0